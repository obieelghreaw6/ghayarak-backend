# Postgres connection string (e.g. from Railway, Supabase, Neon, or your own server)
DATABASE_URL=postgres://user:password@host:5432/ghayarak
PGSSL=true

# Random long string — used to sign login sessions
JWT_SECRET=change-this-to-a-long-random-string

# DPAY merchant account (sign up at dpay.ly)
DPAY_API_TOKEN=your-dpay-api-token
DPAY_WEBHOOK_SECRET=your-dpay-webhook-secret
DPAY_REDIRECT_URL=https://ghayarak.ly/pay/return

# Passcode for the owner login — change before going live
OWNER_PASSCODE=ghayarak-owner

PORT=4000
